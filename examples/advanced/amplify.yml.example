# Candidate for a SEPARATE Git-connected teaching app. Not active in this lab.
# Repository root is aws-amplify-lab; AMPLIFY_MONOREPO_APP_ROOT must equal app.
version: 1
applications:
  - appRoot: app
    backend:
      phases:
        build:
          commands:
            - npm ci --cache .npm --prefer-offline
            - npx ampx pipeline-deploy --branch "$AWS_BRANCH" --app-id "$AWS_APP_ID"
    frontend:
      phases:
        build:
          commands:
            - python3 ../scripts/build-course.py
            - npm run build
      artifacts:
        baseDirectory: dist
        files:
          - '**/*'
      cache:
        paths:
          - .npm/**/*
