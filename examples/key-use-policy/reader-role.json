{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyTheApprovedVersion",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::amplify-aws-example-private/exports/weekly.json",
      "Condition": {
        "StringEquals": {
          "s3:VersionId": "ApprovedVersionA"
        }
      }
    },
    {
      "Sid": "RejectOtherVersionsOfThisObject",
      "Effect": "Deny",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::amplify-aws-example-private/exports/weekly.json",
      "Condition": {
        "StringNotEquals": {
          "s3:VersionId": "ApprovedVersionA"
        }
      }
    },
    {
      "Sid": "RejectUnversionedReadOfThisObject",
      "Effect": "Deny",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::amplify-aws-example-private/exports/weekly.json"
    }
  ]
}
